idef0 0.2
# Template fixture (self-control): i = j into C: up and over the box itself.
# Roadmap M4.3; the probe arrow must route with this class.
model "Template self-control" {
  abbrev "TPL"
}

diagram A0 {
  box 1 "Plan Work"
  box 2 "Do Work"
  box 3 "Check Work"
  arrow : 2O1 -> 2C1 key=probe
}
